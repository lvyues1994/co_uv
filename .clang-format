BasedOnStyle: LLVM
Standard: c++14
IndentWidth: 4
ColumnLimit: 100
SortIncludes: Never
SortUsingDeclarations: Never
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
FixNamespaceComments: false
WhitespaceSensitiveMacros: [CO2_BEG, CO2_END]
StatementMacros: [CO2_AWAIT, CO2_AWAIT_SET, CO2_RETURN, CO2_YIELD]
