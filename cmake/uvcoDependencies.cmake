include(CheckCXXSourceCompiles)
include(CMakePushCheckState)

# For source targets try_compile cannot link a target from the parent build.
# Header-only co2 and libuv's version header only need their build includes.
function(_uvco_collect_probe_usage target seen out_includes out_libraries)
    set(includes)
    set(libraries)
    get_target_property(aliased ${target} ALIASED_TARGET)
    if(aliased)
        set(target ${aliased})
    endif()
    if(NOT target IN_LIST seen)
        list(APPEND seen ${target})
        get_target_property(imported ${target} IMPORTED)
        if(imported)
            # try_compile understands imported targets and their transitive usage.
            list(APPEND libraries ${target})
        else()
            get_target_property(dirs ${target} INTERFACE_INCLUDE_DIRECTORIES)
            foreach(dir IN LISTS dirs)
                if(dir MATCHES "^\\$<INSTALL_INTERFACE:.*>$")
                    continue()
                elseif(dir MATCHES "^\\$<BUILD_INTERFACE:(.*)>$")
                    set(dir "${CMAKE_MATCH_1}")
                endif()
                if(dir MATCHES "\\$<")
                    message(FATAL_ERROR "Unsupported source dependency usage in ${target}: ${dir}; provide an imported dependency target for complex generator expressions")
                elseif(NOT dir MATCHES "-NOTFOUND$")
                    list(APPEND includes "${dir}")
                endif()
            endforeach()
            get_target_property(links ${target} INTERFACE_LINK_LIBRARIES)
            foreach(link IN LISTS links)
                if(link MATCHES "^\\$<BUILD_INTERFACE:(.*)>$")
                    set(link "${CMAKE_MATCH_1}")
                endif()
                if(link MATCHES "^\\$<(INSTALL_INTERFACE|LINK_ONLY):.*>$")
                    continue()
                elseif(link MATCHES "\\$<")
                    message(FATAL_ERROR "Unsupported source dependency usage in ${target}: ${link}; provide an imported dependency target for complex generator expressions")
                endif()
                if(TARGET "${link}")
                    _uvco_collect_probe_usage("${link}" "${seen}" child_includes child_libraries)
                    list(APPEND includes ${child_includes})
                    list(APPEND libraries ${child_libraries})
                endif()
            endforeach()
        endif()
    endif()
    list(REMOVE_DUPLICATES includes)
    list(REMOVE_DUPLICATES libraries)
    set(${out_includes} "${includes}" PARENT_SCOPE)
    set(${out_libraries} "${libraries}" PARENT_SCOPE)
endfunction()

function(_uvco_probe_target target)
    _uvco_collect_probe_usage(${target} "" includes libraries)
    set(CMAKE_REQUIRED_INCLUDES "${includes}" PARENT_SCOPE)
    set(CMAKE_REQUIRED_LIBRARIES "${libraries}" PARENT_SCOPE)
endfunction()

function(uvco_check_co2 out include_dir probe)
    cmake_push_check_state(RESET)
    set(CMAKE_CXX_STANDARD 14)
    set(CMAKE_CXX_STANDARD_REQUIRED YES)
    set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
    _uvco_probe_target(co2::co2)
    list(APPEND CMAKE_REQUIRED_INCLUDES "${include_dir}")
    file(READ "${probe}" source)
    unset(UVCO_CO2_COMPATIBLE CACHE)
    check_cxx_source_compiles("${source}" UVCO_CO2_COMPATIBLE)
    set(${out} ${UVCO_CO2_COMPATIBLE} PARENT_SCOPE)
    cmake_pop_check_state()
endfunction()

function(uvco_select_libuv out)
    foreach(candidate IN ITEMS libuv::uv libuv::uv_a uv_a uv)
        if(TARGET ${candidate})
            set(${out} ${candidate} PARENT_SCOPE)
            return()
        endif()
    endforeach()
    set(${out} "" PARENT_SCOPE)
endfunction()

function(uvco_check_libuv out target)
    cmake_push_check_state(RESET)
    set(CMAKE_CXX_STANDARD 14)
    set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
    _uvco_probe_target(${target})
    unset(UVCO_LIBUV_COMPATIBLE CACHE)
    check_cxx_source_compiles("#include <uv/version.h>
#if !defined(UV_VERSION_HEX) || UV_VERSION_HEX < ((1 << 16) | (40 << 8))
#error uvco requires libuv >= 1.40
#endif
int main() { return 0; }" UVCO_LIBUV_COMPATIBLE)
    set(${out} ${UVCO_LIBUV_COMPATIBLE} PARENT_SCOPE)
    cmake_pop_check_state()
endfunction()
