@PACKAGE_INIT@
# Capture before nested find_dependency configs modify PACKAGE_PREFIX_DIR on
# CMake < 3.30. No build-machine paths are stored in the exported target.
set(_uvco_include_dir "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
include(CMakeFindDependencyMacro)
find_dependency(co2 CONFIG)
if("@UVCO_LIBUV_PROVIDER@" STREQUAL "pkgconfig")
    find_dependency(PkgConfig)
    pkg_check_modules(UVCO_LIBUV QUIET IMPORTED_TARGET GLOBAL libuv>=1.40)
    if(NOT UVCO_LIBUV_FOUND)
        set(uvco_FOUND FALSE)
        set(uvco_NOT_FOUND_MESSAGE "uvco requires pkg-config libuv >= 1.40")
        return()
    endif()
    set(_uvco_libuv_target PkgConfig::UVCO_LIBUV)
else()
    find_dependency(libuv CONFIG)
    include("${CMAKE_CURRENT_LIST_DIR}/uvcoDependencies.cmake")
    uvco_select_libuv(_uvco_libuv_target)
    if(NOT _uvco_libuv_target)
        set(uvco_FOUND FALSE)
        set(uvco_NOT_FOUND_MESSAGE "libuv config must provide libuv::uv or libuv::uv_a (uv/uv_a accepted)")
        return()
    endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/uvcoDependencies.cmake")
uvco_check_co2(_uvco_co2_ok "${_uvco_include_dir}" "${CMAKE_CURRENT_LIST_DIR}/co2_capability.cpp")
uvco_check_libuv(_uvco_libuv_ok ${_uvco_libuv_target})
if(NOT _uvco_co2_ok OR NOT _uvco_libuv_ok)
    set(uvco_FOUND FALSE)
    set(uvco_NOT_FOUND_MESSAGE "Incompatible co2 internal API or libuv headers < 1.40; see configure probe diagnostics")
    return()
endif()
if(NOT TARGET uvco::dependencies)
    add_library(uvco::dependencies INTERFACE IMPORTED)
    set_property(TARGET uvco::dependencies PROPERTY INTERFACE_LINK_LIBRARIES "co2::co2;${_uvco_libuv_target}")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/uvcoTargets.cmake")
set(uvco_kcp_FOUND @UVCO_ENABLE_KCP@)
set(uvco_HAS_KCP @UVCO_ENABLE_KCP@)
check_required_components(uvco)
