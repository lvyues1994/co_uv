set(work "@PROJECT_BINARY_DIR@/package-tests")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}")
function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Command: ${ARGV}\n${out}\n${err}")
    endif()
endfunction()
set(deps "${work}/deps")
if(NOT "@co2_BINARY_DIR@" STREQUAL "")
    run("@CMAKE_COMMAND@" "-DCMAKE_INSTALL_PREFIX=${deps}" "-DCMAKE_INSTALL_CONFIG_NAME=${CONFIG}" -P "@co2_BINARY_DIR@/cmake_install.cmake")
endif()
run("@CMAKE_COMMAND@" "-DCMAKE_INSTALL_PREFIX=${work}/stage" "-DCMAKE_INSTALL_CONFIG_NAME=${CONFIG}" -P "@PROJECT_BINARY_DIR@/cmake_install.cmake")
set(license "${work}/stage/@CMAKE_INSTALL_DATADIR@/licenses/uvco/LICENSE")
if(NOT EXISTS "${license}")
    message(FATAL_ERROR "Installed copies must include the MIT license")
endif()
file(READ "${license}" license_text)
string(FIND "${license_text}" "Copyright (c) 2026 yu.shang" copyright_notice)
if(copyright_notice EQUAL -1)
    message(FATAL_ERROR "Installed license lost the copyright notice")
endif()
if(EXISTS "${work}/stage/include/co2")
    message(FATAL_ERROR "uvco install must not bundle fetched dependencies")
endif()
file(RENAME "${work}/stage" "${work}/relocated")
file(GLOB_RECURSE configs "${work}/relocated/*.cmake")
foreach(config IN LISTS configs)
    file(READ "${config}" text)
    string(FIND "${text}" "@PROJECT_SOURCE_DIR@" leaked_source)
    string(FIND "${text}" "@PROJECT_BINARY_DIR@" leaked_build)
    if(NOT leaked_source EQUAL -1 OR NOT leaked_build EQUAL -1)
        message(FATAL_ERROR "Non-relocatable path in ${config}")
    endif()
endforeach()
set(prefix "${work}/relocated;${deps};@CMAKE_PREFIX_PATH@")
foreach(mode IN ITEMS installed subdirectory fetchcontent)
    set(extra)
    if(NOT mode STREQUAL "installed")
        list(APPEND extra "-DUVCO_SOURCE_DIR=@PROJECT_SOURCE_DIR@")
    endif()
    # Protect list-valued prefix arguments across function(ARGV) expansion.
    string(REPLACE ";" "\;" escaped_prefix "${prefix}")
    run("@CMAKE_COMMAND@" -S "@PROJECT_SOURCE_DIR@/tests/consumer" -B "${work}/${mode}"
        -G "@CMAKE_GENERATOR@" "-DCMAKE_C_COMPILER=@CMAKE_C_COMPILER@"
        "-DCMAKE_CXX_COMPILER=@CMAKE_CXX_COMPILER@" "-DCMAKE_BUILD_TYPE=@CMAKE_BUILD_TYPE@"
        "-DCMAKE_CXX_FLAGS=@CMAKE_CXX_FLAGS@" "-DCMAKE_EXE_LINKER_FLAGS=@CMAKE_EXE_LINKER_FLAGS@"
        "-DCMAKE_PREFIX_PATH=${escaped_prefix}" "-DUVCO_CONSUMER_MODE=${mode}" ${extra})
    run("@CMAKE_COMMAND@" --build "${work}/${mode}" --config "${CONFIG}" --parallel 2)
    run("@CMAKE_COMMAND@" -E chdir "${work}/${mode}" "@CMAKE_CTEST_COMMAND@" -C "${CONFIG}" --output-on-failure)
    if(NOT mode STREQUAL "installed")
        run("@CMAKE_COMMAND@" "-DCMAKE_INSTALL_PREFIX=${work}/disabled-${mode}" "-DCMAKE_INSTALL_CONFIG_NAME=${CONFIG}" -P "${work}/${mode}/cmake_install.cmake")
        file(GLOB_RECURSE unexpected "${work}/disabled-${mode}/*")
        if(unexpected)
            message(FATAL_ERROR "Disabled subproject install unexpectedly installed files: ${unexpected}")
        endif()
    endif()
endforeach()
