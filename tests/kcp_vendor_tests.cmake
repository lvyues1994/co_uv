# These hashes are from the approved upstream commit, not computed from the vendored files.
foreach(name IN ITEMS ikcp.c ikcp.h LICENSE)
  if(NOT EXISTS "${SOURCE}/third_party/kcp/${name}")
    message(FATAL_ERROR "KCP vendor missing: ${name}")
  endif()
endforeach()
file(SHA256 "${SOURCE}/third_party/kcp/ikcp.c" actual)
if(NOT actual STREQUAL "8654038a70d1bbe605aa94f066554ffb30bf28580a58769970221de3ba5027f0")
  message(FATAL_ERROR "ikcp.c differs from approved upstream")
endif()
file(SHA256 "${SOURCE}/third_party/kcp/ikcp.h" actual)
if(NOT actual STREQUAL "d67a0e67ba5701f1e882894b4415c4d3ad3d7d9f7231dd2ca68c6037c5217933")
  message(FATAL_ERROR "ikcp.h differs from approved upstream")
endif()
file(SHA256 "${SOURCE}/third_party/kcp/LICENSE" actual)
if(NOT actual STREQUAL "6587fd02a924b97dbd6758b0573ddec056fb494a84f3709c5aaa33ce1f7f029c")
  message(FATAL_ERROR "upstream MIT notice differs")
endif()
